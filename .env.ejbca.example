# EJBCA + EJBCA Gateway development environment
# Copy to .env.ejbca (or pass with --env-file) and replace all passwords before use.
# Never commit real credentials.

# Existing UCM development bindings
UCM_DEV_BIND=127.0.0.1
UCM_HTTPS_PORT=8443
UCM_HTTP_PORT=8080

# EJBCA images and container names
EJBCA_IMAGE=keyfactor/ejbca-ce:latest
EJBCA_CONTAINER_NAME=ucm-ejbca
EJBCA_DATABASE_IMAGE=postgres:16-alpine
EJBCA_DATABASE_CONTAINER_NAME=ucm-ejbca-database

# EJBCA PostgreSQL database
EJBCA_DB_NAME=ejbca
EJBCA_DB_USER=ejbca
EJBCA_DB_PASSWORD=change-me-in-development

# EJBCA runtime
EJBCA_LOG_LEVEL_APP=INFO
EJBCA_LOG_LEVEL_SERVER=INFO
# "simple" is for isolated development only. Use mTLS/TLS certificates outside dev.
EJBCA_TLS_SETUP_ENABLED=simple

# EJBCA Gateway -> EJBCA connection
EJBCA_API_URL=https://ejbca:8443/ejbca/ejbca-rest-api
EJBCA_TLS_VERIFY=false
EJBCA_REQUEST_TIMEOUT_SECONDS=30

# EJBCA Gateway service
EJBCA_GATEWAY_CONTAINER_NAME=ucm-ejbca-gateway
EJBCA_GATEWAY_PORT=8081
EJBCA_GATEWAY_LOG_LEVEL=DEBUG
UCM_AUTH_BASE_URL=http://ucm:8080
UCM_INTERNAL_AUTH_SECRET=change-me-in-development

# Frontend development routing (reserved for v3 migration)
VITE_EJBCA_GATEWAY_URL=http://127.0.0.1:8081
VITE_EJBCA_GATEWAY_API_PREFIX=/api/v3
